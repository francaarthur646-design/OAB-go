@charset "utf-8";

:root { --bg: #f6f4ee; --panel: #ffffff; --ink: #1c2b24; --ink-soft: #5b6b62; --line: #dcd7c9; --gold: #a9822e; --gold-soft: #f1e6c8; --green: #2f4a3c; --green-soft: #e4ede6; --red: #8a3a2b; --red-soft: #f3e2dc; --blue: #2f5470; --blue-soft: #e1e9ee; --purple: #5a4a7a; --purple-soft: #eae5f2; --teal: #2a6b6b; --teal-soft: #e0edec; --grey: #6a6458; --grey-soft: #ebe8de; --shadow: 0 2px 10px rgba(28,43,36,0.07); --radius: 10px; font-family: Inter, system-ui, sans-serif; }

:root:not([data-theme="light"]) {
  @media (prefers-color-scheme: dark) {
  --bg: #14201a; --panel: #1c2b24; --ink: #eee9dc; --ink-soft: #a9b7ae; --line: #33453b; --gold: #d8b25a; --gold-soft: #3a3423; --green: #8fbf9f; --green-soft: #22352b; --red: #d99485; --red-soft: #3a2822; --blue: #9bc2dd; --blue-soft: #1f2e38; --purple: #c3b1e0; --purple-soft: #2b2438; --teal: #8fd0cb; --teal-soft: #1c2f2e; --grey: #b7b2a3; --grey-soft: #2a2a22; --shadow: 0 2px 14px rgba(0,0,0,0.35);
}
}

:root[data-theme="dark"] { --bg: #14201a; --panel: #1c2b24; --ink: #eee9dc; --ink-soft: #a9b7ae; --line: #33453b; --gold: #d8b25a; --gold-soft: #3a3423; --green: #8fbf9f; --green-soft: #22352b; --red: #d99485; --red-soft: #3a2822; --blue: #9bc2dd; --blue-soft: #1f2e38; --purple: #c3b1e0; --purple-soft: #2b2438; --teal: #8fd0cb; --teal-soft: #1c2f2e; --grey: #b7b2a3; --grey-soft: #2a2a22; --shadow: 0 2px 14px rgba(0,0,0,0.35); }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--bg); color: var(--ink); min-height: 100vh; padding: 20px 14px 60px; }

.wrap { max-width: 920px; margin: 0px auto; }

header { margin-bottom: 18px; }

h1 { font-family: "Source Serif 4", serif; font-weight: 700; font-size: 1.6rem; margin: 0px 0px 4px; letter-spacing: -0.01em; }

.sub { color: var(--ink-soft); font-size: 0.92rem; margin: 0px; }

.progress-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 16px 18px; margin: 16px 0px; }

.progress-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; flex-wrap: wrap; gap: 6px; }

.progress-top .n { font-family: "Source Serif 4", serif; font-size: 1.5rem; font-weight: 600; color: var(--green); }

.progress-top .label { font-size: 0.85rem; color: var(--ink-soft); }

.bar-track { height: 8px; border-radius: 5px; background: var(--grey-soft); overflow: hidden; }

.bar-fill { height: 100%; background: var(--green); border-radius: 5px; transition: width 0.3s; }

.discipline-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }

.chip { font-size: 0.72rem; padding: 4px 9px; border-radius: 20px; border: 1px solid var(--line); color: var(--ink-soft); white-space: nowrap; }

.controls { display: flex; gap: 8px; align-items: center; margin: 14px 0px 10px; flex-wrap: wrap; }

.controls input[type="text"] { flex: 1 1 0%; min-width: 140px; padding: 9px 12px; border-radius: 8px; border: 1px solid var(--line); background: var(--panel); color: var(--ink); font-size: 0.9rem; }

.controls select { padding: 9px 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--panel); color: var(--ink); font-size: 0.85rem; }

.month-nav { display: flex; align-items: center; justify-content: space-between; margin: 16px 0px 8px; }

.month-nav button { border: 1px solid var(--line); background: var(--panel); color: var(--ink); border-radius: 8px; width: 34px; height: 34px; font-size: 1rem; cursor: pointer; }

